{
  "name": "crumbnod",
  "version": "0.1.0",
  "description": "MIT-licensed, dependency-free cookie consent for the web.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://peternickol.github.io/crumbnod/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peternickol/crumbnod.git"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./crumbnod.d.ts",
  "exports": {
